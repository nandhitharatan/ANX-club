# Documents - per explicit instruction: "Don't send docx"
*.docx
**/*.docx

# Environment variables & secrets
.env
.env*.local
**/.env
**/.env*.local

# Node dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
.next/
**/.next/
/out/
/build/

# Testing coverage
/coverage/

# Misc & OS files
.DS_Store
Thumbs.db
*.pem

# Logs
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tool caches
.vercel
.gemini/
**/.gemini/
.swc/
**/.swc/

# TypeScript build cache
*.tsbuildinfo
**/*.tsbuildinfo
